mainmenu "Lab 0 - Minimal IoT Implementation (MQTT)"

config LAB_WIFI_SSID
	string "Wi-Fi SSID"
	default "changeme"
	help
	  Name of the 2.4 GHz network the node joins. The ESP32-C6 radio does
	  not associate with 5 GHz-only APs.

config LAB_WIFI_PSK
	string "Wi-Fi password"
	default "changeme"

config LAB_BROKER_ADDR
	string "MQTT broker IPv4 address"
	default "192.168.1.4"
	help
	  IPv4 address of the workstation running Mosquitto. Do not use localhost;
	  the ESP32 must reach the broker over Wi-Fi.

config LAB_BROKER_PORT
	int "MQTT broker port"
	default 1883

source "Kconfig.zephyr"
